package templates

templ style() {
   <style>
      :root {
         --primary: #6B4593;
         --dark: #121016;
         --dark-2: #1A1721;
         --dark-3: #24202D;
         --light: #F4F1F8;
         --light-2: #B7AEC5;
         --light-3: #7D748D;
      }
      * {
         margin: 0;
         padding: 0;
         color: var(--light);
         font-family: 'Segoe UI', sans-serif;
      }
      body {
         background-color: var(--dark);
      }
      #navbar {
         position: fixed;
         bottom: 0;
         left: 0;
         width: 100%;
         height: 3rem;
         display: flex;
         justify-content: space-around;
         align-items: center;
         background: var(--dark);
         border-top: 1px solid var(--primary);
         border-radius: 12px 12px 0 0;
      }
      #header {
         position: fixed;
         top: 0;
         left: 0;
         width: 100vw;
         height: 3rem;
         display: flex;
         align-items: center;
         justify-content: space-between;
         background: var(--dark);
         border-bottom: 1px solid var(--primary);
         border-radius: 12px;
      }
      #header > div {
         margin: .3rem;
      }
      .nav-item {
         text-decoration: none;
         font-weight: 600;
         color: var(--primary);
      }
      .main {
         margin: .4rem;
         margin-top: 3.4rem;
      }
      .counter-card {
         border: 1px solid var(--primary);
         display: flex;
         align-items: center;
         justify-content: space-between;
         padding: .6rem;
         margin-bottom: .3rem;
         border-radius: 12px;
      }
      .counter-card:last-child {
         margin-bottom: 3.3rem;
      }
      .counter-title {
         font-size: 1.3rem;
         font-weight: 500;
      }
      .counter-owner {
         font-size: .8rem;
         color: var(--light-2);
      }
      .button {
         background-color: var(--primary);
         color: var(--light);
         border-radius: 12px;
         padding: .4rem;
         border: 1px solid var(--light)
      }
      .button-dark {
         background-color: var(--dark);
         color: var(--primary);
         border-radius: 12px;
         padding: .4rem;
         border: 1px solid var(--primary)
      }
      .button-container {
         display: flex;
         width: 100%;
         align-items: center;
         justify-content: center;
         margin-top: .4rem;
         margin-bottom: -2rem;
      }
      .button-footer {
         position: absolute;
         width: 100%;
         bottom: 2%;
         left: 0;
         display: flex;
         align-items: center;
         justify-content: space-around;
      }
      .button-footer > button {
         width: 35vw;
      }
      .button-close {
         text-decoration: none;
         padding-left: .8rem;
         padding-right: .8rem;
      }
      .button-increment {
         text-decoration: none;
         padding-left: 1rem;
         padding-right: 1rem;
         font-weight: 900;
         font-size: 2.25rem;
      }
      input {
         border-radius: 12px;
         background-color: var(--dark-2);
         color: var(--light);
         padding: .3rem;
         border: 1px solid var(--primary);
      }
   </style>
}
